{
    "configurations": [
        {
            "name": "Pico",
            "includePath": [
                "${workspaceFolder}/**",
                "${userHome}/.pico-sdk/sdk/2.2.0/**",
                "${env:USERPROFILE}/.pico-sdk/toolchain/14_2_Rel1/arm-none-eabi/include",
                "${env:USERPROFILE}/.pico-sdk/toolchain/14_2_Rel1/lib/gcc/arm-none-eabi/14.2.1/include"
            ],
            "forcedInclude": [
                "${workspaceFolder}/inc/main.h",
                "${workspaceFolder}/build/generated/pico_base/pico/config_autogen.h",
                "${userHome}/.pico-sdk/sdk/2.2.0/src/common/pico_base_headers/include/pico.h"
            ],
            "defines": [
                "PICO_BOARD=\"pico2_w\"",
                "LIB_PICO_STDLIB=1",
                "PICO_RP2350=1"
            ],
            "compilerPath": "${userHome}/.pico-sdk/toolchain/14_2_Rel1/bin/arm-none-eabi-gcc.exe",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "cStandard": "c17",
            "cppStandard": "c++14",
            "intelliSenseMode": "gcc-arm"
        }
    ],
    "version": 4
}